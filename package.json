{
  "name": "sketchbook-wakes-up",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A playful video made from hand-drawn watercolor sketches, rendered and scored entirely in JavaScript.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Abderrehmen Gharsallah",
  "scripts": {
    "segment": "node src/extract/segment.js",
    "extract": "node src/extract/export.js && node src/extract/textures.js",
    "voices": "node src/audio/voices.js",
    "narrate": "node src/tools/narrate.js",
    "align": "node src/tools/align.js",
    "captions": "node src/tools/captions.js",
    "audio": "node src/audio/render-audio.js",
    "video": "node src/video/render.js",
    "preview": "node src/video/render.js --sheet",
    "qa": "node src/tools/qa.js",
    "share": "node src/tools/share.js",
    "build": "pnpm extract && pnpm voices && pnpm audio && pnpm video",
    "story:new": "node src/tools/new-story.js",
    "story:validate": "node src/story/validate.js",
    "kit:sheet": "node src/tools/kit-sheet.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "sharp": "^0.35.4"
  }
}
